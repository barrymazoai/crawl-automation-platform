# GNC 抓取 Pool：capture_catalog（gnc），保留 IP 轮动（egress 守卫要求单槽 + 只挂 gnc）
# 其余 GNC egress 变量照 scripts/mac/start-gnc-worker.sh 现有配置复制。
NODE_ID=mac-mini-v2-capture-gnc-1
NODE_NAME=V2 GNC Capture
NODE_CAPABILITIES=gnc
NODE_SOURCE_ADAPTERS=gnc
NODE_MAX_CONCURRENCY=1
CODEX_CONCURRENCY=1
V2_CAPTURE_BATCH_SIZE=25
DISK_SOFT_MIN_FREE_GB=40
DISK_HARD_MIN_FREE_GB=15
SALES_CHANNEL_EGRESS_ENABLED=true
