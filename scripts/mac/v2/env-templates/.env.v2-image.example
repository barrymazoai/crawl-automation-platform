# 图片/OCR Pool：process_images
# job 并发允许多 Batch 交错（Batch N 在 OCR 时 Batch N+1 在下载），实际 OCR 并发由
# OCR_IMAGE_CONCURRENCY 进程级信号量兜底；OCR 服务吞吐提升时只改这一个值。
NODE_ID=mac-mini-v2-image-1
NODE_NAME=V2 Image/OCR Pool
NODE_CAPABILITIES=process_images
NODE_MAX_CONCURRENCY=3
OCR_IMAGE_CONCURRENCY=4
CODEX_CONCURRENCY=2
