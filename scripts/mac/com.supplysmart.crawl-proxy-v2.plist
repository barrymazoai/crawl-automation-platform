<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.supplysmart.crawl-proxy-v2</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Clash Verge.app/Contents/MacOS/verge-mihomo</string>
