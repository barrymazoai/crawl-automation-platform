{
  "name": "@crawl-automation/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown src/index.ts src/migrate.ts src/workers/capture-gnc.ts src/workers/capture-amazon.ts src/workers/capture-swanson.ts src/workers/capture-dtc.ts src/workers/text.ts src/workers/image.ts src/workers/unify.ts src/workers/finalize.ts --format esm",
    "start": "node dist/index.js",
    "backfill:amazon:dry": "tsx scripts/amazon-backfill-dry-run.ts",
    "backfill:amazon:image": "tsx scripts/amazon-backfill-image-lane.ts",
    "backfill:amazon:formula": "tsx scripts/amazon-backfill-formula-dry-run.ts",
    "backfill:amazon:formula-vision": "tsx scripts/amazon-backfill-formula-vision-recovery.ts",
    "backfill:amazon:staging": "tsx scripts/amazon-backfill-staging-lane.ts",
    "backfill:amazon:snapshot-source": "tsx scripts/amazon-backfill-snapshot-source.ts",
    "backfill:amazon:supervisor": "tsx scripts/amazon-backfill-supervisor.ts",
    "gnc:identity-agent": "tsx scripts/gnc-company-identity-agent.ts",
    "gnc:px-cooldown-probe": "tsx scripts/gnc-px-cooldown-probe.ts",
    "gnc:traffic-probe": "tsx scripts/gnc-traffic-probe.ts",
    "migrate": "tsx src/migrate.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "worker:capture-gnc": "node dist/workers/capture-gnc.js",
    "worker:capture-amazon": "node dist/workers/capture-amazon.js",
    "worker:capture-swanson": "node dist/workers/capture-swanson.js",
    "worker:capture-dtc": "node dist/workers/capture-dtc.js",
    "worker:text": "node dist/workers/text.js",
    "worker:image": "node dist/workers/image.js",
    "worker:unify": "node dist/workers/unify.js",
    "worker:finalize": "node dist/workers/finalize.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@crawl-automation/contracts": "workspace:*",
    "@crawl-automation/ocr-client": "workspace:*",
    "@crawl-automation/runtime": "workspace:*",
    "@hono/node-server": "catalog:",
    "@orpc/server": "catalog:",
    "cron-parser": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "linkedom": "^0.18.13",
    "pg": "catalog:",
    "pino": "catalog:",
    "undici": "^7.29.0",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
