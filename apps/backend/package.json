{
  "name": "@crawl-automation/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown src/index.ts src/mac-worker.ts src/migrate.ts --format esm",
    "start": "node dist/index.js",
    "start:worker": "node dist/mac-worker.js",
    "migrate": "tsx src/migrate.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@crawl-automation/contracts": "workspace:*",
    "@crawl-automation/ocr-client": "workspace:*",
    "@crawl-automation/runtime": "workspace:*",
    "@hono/node-server": "catalog:",
    "@orpc/server": "catalog:",
    "cron-parser": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "undici": "^7.29.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
