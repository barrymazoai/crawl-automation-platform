PORT=8080
BACKEND_MODE=control-plane
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crawl_automation
ADMIN_API_TOKEN=replace-with-at-least-24-characters
BROWSER_NODE_TOKEN=replace-with-at-least-24-characters
MAC_NODE_TOKEN=replace-with-at-least-24-characters
CONTROL_PLANE_URL=https://crawl-control-plane-production.up.railway.app
CONTROL_PLANE_PROXY_URL=
LAN_UI_ENABLED=false
LEASE_TTL_SECONDS=120
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=crawl-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
OCR_ENDPOINT=http://192.168.0.6:8081/ocr?min_score=0.3
PRODUCT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Jakarta Product Server base URL. RPC writes go here; PRODUCT_DATABASE_URL is now read-only for vocab/company lookup.
PRODUCT_SERVER_URL=http://127.0.0.1:3000
# Current internal Product Server does not require a token. Set only when routed through an authenticated gateway.
PRODUCT_SERVER_TOKEN=
# Public biz-server /database gateway uses a service API key in x-api-key. Set PRODUCT_SERVER_URL to https://<biz-server>/database in that mode.
PRODUCT_SERVER_API_KEY=
# Leave CHROME_CDP_URL unset to let the Mac worker start and own a visible Chrome.
# CHROME_CDP_URL=http://127.0.0.1:9222
SALES_CHANNEL_CHROME_PROFILE_ROOT=/Users/barry/apps/crawl-automation/state/chrome
NODE_ID=mac-mini-1
NODE_NAME="Mac mini Processing Worker"
NODE_MAX_CONCURRENCY=2
NODE_CAPABILITIES=amazon,gnc,swanson,process,ingest,cleanup
# Optional hard allowlist for claims. A dedicated GNC worker should use `gnc` so
# its generic cleanup capability cannot claim Amazon or DTC cleanup jobs.
NODE_SOURCE_ADAPTERS=
CODEX_CONCURRENCY=2
OCR_IMAGE_CONCURRENCY=4
AMAZON_MAX_ITEMS=500
GNC_MAX_ITEMS=500
SWANSON_MAX_ITEMS=2000
GNC_PDF_RENDER_SCRIPT=/Users/barry/apps/browser-scaperskill/scripts/mac/render-pdf-pages.swift
# Optional shared Sales Channel egress manager. Enable only on a dedicated,
# single-concurrency worker until every fixed adapter is wired to the common manager.
SALES_CHANNEL_EGRESS_ENABLED=false
SALES_CHANNEL_EGRESS_STATE_DB=/Users/barry/apps/crawl-automation/state/sales-channel-egress.sqlite
SALES_CHANNEL_EGRESS_PROFILE_ROOT=/Users/barry/apps/crawl-automation/state/sales-channel-egress-chrome
SALES_CHANNEL_CLASH_CONFIG_FILE=/Users/barry/Library/Application Support/io.github.clash-verge-rev.clash-verge-rev/clash-verge.yaml
SALES_CHANNEL_CLASH_CONTROLLER_URL=http://127.0.0.1:9097
GNC_EGRESS_POOL=us-residential-4
GNC_EGRESS_SELECTOR=GNC出口
GNC_EGRESS_EXITS=texas=美国德州ip,washington=美国华盛顿ip,los-angeles=美国洛杉矶ip,redmond=美国雷德蒙德ip
GNC_EGRESS_BATCH_SIZE=20
GNC_EGRESS_CHALLENGE_COOLDOWN_MS=600000
GNC_EGRESS_NETWORK_FAILURE_COOLDOWN_MS=120000
GNC_EGRESS_MAX_FAILURE_RETRIES=4
WORK_ROOT=/Users/barry/apps/crawl-automation/runs
LOCAL_STATE_DB=/Users/barry/apps/crawl-automation/state/mac.sqlite
REPOSITORY_ROOT=/Users/barry/apps/browser-scaperskill
CODEX_EXECUTABLE=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=medium
CODEX_UNATTENDED_FULL_ACCESS=false
