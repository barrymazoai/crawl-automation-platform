{
  "name": "@crawl-automation/browser-node",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown src/index.ts --format esm",
    "start": "node dist/index.js",
    "smoke:app-server": "pnpm --filter @crawl-automation/runtime build && node scripts/smoke-app-server.mjs",
    "capture:local": "pnpm --filter @crawl-automation/runtime build && node scripts/run-local-capture.mjs",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crawl-automation/contracts": "workspace:*",
    "@crawl-automation/runtime": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
