CONTROL_PLANE_URL=https://crawl-control-plane-production.up.railway.app
NODE_TOKEN=replace-with-browser-node-token
NODE_ID=windows-browser-1
NODE_NAME=Windows Browser Worker
NODE_CONCURRENCY=2
WORK_ROOT=C:\crawl-automation\runs
LOCAL_STATE_DB=C:\crawl-automation\state\browser.sqlite
# 站点 profile 本地缓存（权威副本在控制面对象存储，开工前拉/收工后推）
SITE_PROFILE_DIR=C:\crawl-automation\site-profiles
REPOSITORY_ROOT=C:\crawl-automation\browser-scaperskill
CODEX_EXECUTABLE=codex
CODEX_RUNNER=app-server
CODEX_SKILL_PATH=C:\crawl-automation\browser-scaperskill\crawl-products\SKILL.md
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=medium
CODEX_UNATTENDED_FULL_ACCESS=false
CHROME_EXECUTABLE_PATH=
CHROME_HEADLESS=false
CHROME_PROFILE_ROOT=C:\crawl-automation\chrome-profiles
CHROME_STARTUP_TIMEOUT_MS=20000
