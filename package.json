{
  "name": "crawl-automation-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "pretest": "pnpm --filter @crawl-automation/runtime... build",
    "test": "vitest run packages apps/backend/src --no-cache && pnpm --dir crawl-products test",
    "dev:web": "pnpm --filter @crawl-automation/web dev",
    "dev:backend": "pnpm --filter @crawl-automation/backend dev",
    "start:browser-node": "pnpm build && pnpm --filter @crawl-automation/browser-node start",
    "start:mac-worker": "pnpm build && pnpm --filter @crawl-automation/backend start:worker"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
