{
  "name": "@crawl-automation/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./browser-routing": {
      "types": "./src/browser/browser-routing.ts",
      "import": "./src/browser/browser-routing.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./temporal-worker": {
      "types": "./src/temporal-worker/index.ts",
      "import": "./src/temporal-worker/index.ts"
    },
    "./errors/resource-gate": {
      "types": "./src/errors/resource-gate-errors.ts",
      "import": "./src/errors/resource-gate-errors.ts"
    },
    "./errors/label-core": {
      "types": "./src/errors/label-core-errors.ts",
      "import": "./src/errors/label-core-errors.ts"
    },
    "./errors/activity": {
      "types": "./src/errors/activity-errors.ts",
      "import": "./src/errors/activity-errors.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@crawl-automation/v3-contracts": "workspace:*",
    "@temporalio/client": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "execa": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
